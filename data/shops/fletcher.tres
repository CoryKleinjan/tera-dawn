[gd_resource type="Resource" script_class="ShopDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/shop_def.gd" id="1_shop_def"]
[ext_resource type="Script" path="res://scripts/data/shop_entry.gd" id="2_shop_entry"]
[ext_resource type="Resource" path="res://data/items/equips/hunters_bow.tres" id="e_hunters_bow"]

[sub_resource type="Resource" id="Entry_hunters_bow"]
script = ExtResource("2_shop_entry")
item = ExtResource("e_hunters_bow")
price = 0

[resource]
script = ExtResource("1_shop_def")
id = &"fletcher"
display_name = "Greenbough Fletcher"
items = Array[ExtResource("2_shop_entry")]([SubResource("Entry_hunters_bow")])
