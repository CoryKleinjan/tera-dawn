[ext_resource type="Resource" path="res://data/items/equips/vanguard_armor.tres" id="e_vanguard_armor"]
[ext_resource type="Resource" path="res://data/items/equips/vanguard_sword.tres" id="e_vanguard_sword"]

[sub_resource type="Resource" id="Entry_vanguard_armor"]
