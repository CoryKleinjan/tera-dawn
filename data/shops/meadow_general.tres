[gd_resource type="Resource" script_class="ShopDef" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/shop_def.gd" id="1_shop"]
[ext_resource type="Script" path="res://scripts/data/shop_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://data/items/use/return_scroll.tres" id="item_return_scroll"]
[ext_resource type="Resource" path="res://data/items/use/dawnrise_scroll.tres" id="item_dawnrise_scroll"]

[sub_resource type="Resource" id="entry_return_scroll"]
script = ExtResource("2_entry")
item = ExtResource("item_return_scroll")
price = 0

[sub_resource type="Resource" id="entry_dawnrise_scroll"]
script = ExtResource("2_entry")
item = ExtResource("item_dawnrise_scroll")
price = 0

[resource]
script = ExtResource("1_shop")
id = &"meadow_general"
display_name = "Mira's General Store"
items = Array[ExtResource("2_entry")]([SubResource("entry_return_scroll"), SubResource("entry_dawnrise_scroll")])
