[gd_resource type="Resource" script_class="ShopDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/shop_def.gd" id="1_shop_def"]
[ext_resource type="Script" path="res://scripts/data/shop_entry.gd" id="2_shop_entry"]
[ext_resource type="Resource" path="res://data/items/equips/deckhand_scimitar.tres" id="e_deckhand_scimitar"]

[sub_resource type="Resource" id="Entry_deckhand_scimitar"]
script = ExtResource("2_shop_entry")
item = ExtResource("e_deckhand_scimitar")
price = 0

[resource]
script = ExtResource("1_shop_def")
id = &"shipwright"
display_name = "Driftcove Outfitter"
items = Array[ExtResource("2_shop_entry")]([SubResource("Entry_deckhand_scimitar")])
