[gd_resource type="Resource" script_class="ShopDef" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/data/shop_def.gd" id="1_shop_def"]
[ext_resource type="Script" path="res://scripts/data/shop_entry.gd" id="2_shop_entry"]
[ext_resource type="Resource" path="res://data/items/setup/lantern_bench.tres" id="s_lantern_bench"]

[sub_resource type="Resource" id="Entry_lantern_bench"]
script = ExtResource("2_shop_entry")
item = ExtResource("s_lantern_bench")
price = 6000

[resource]
script = ExtResource("1_shop_def")
id = &"fence"
display_name = "Lanternfall Fence"
items = Array[ExtResource("2_shop_entry")]([SubResource("Entry_lantern_bench")])
