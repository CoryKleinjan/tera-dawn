[resource]
script = ExtResource("1_npc_def")
id = &"lumewood_keeper"
display_name = "Iris"
title = "Storage Keeper"
sprite_frames = ExtResource("2_sprite")
greeting = "Iris's vaults, sealed with a little crystal ward. Leave it here and the keepers in every town can hand it back to you."
