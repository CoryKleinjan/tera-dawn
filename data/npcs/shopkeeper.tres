[resource]
script = ExtResource("1_npc_def")
id = &"shopkeeper"
display_name = "Mira"
title = "Shopkeeper"
texture = ExtResource("2_shopkeeper")
sprite_scale = 1.0
greeting = "Welcome, welcome! Scrolls for the road, and I pay fair for anything the monsters drop."
lines = PackedStringArray("A Return Scroll is cheap, and it might save your life in Fern Hollow.", "Sell me your monster parts. Boar Tusks fetch a good price!", "Monsters drop parts and runes, never gear. Weapons and armor come from the job towns' shops.")
shop = ExtResource("3_shop")
