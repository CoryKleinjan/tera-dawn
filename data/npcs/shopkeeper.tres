[resource]
script = ExtResource("1_npc_def")
id = &"shopkeeper"
display_name = "Mira"
title = "Shopkeeper"
texture = ExtResource("2_shopkeeper")
sprite_scale = 1.0
greeting = "Welcome, welcome! Potions for the road, gear for the fight. And I pay fair for anything the monsters drop."
lines = PackedStringArray("Red Potions are cheap, but an Elixir will save your life in Fern Hollow.", "Sell me your monster parts. Boar Tusks fetch a good price!", "Gear from monsters can roll better stats than mine. Keep an eye on those drops.")
shop = ExtResource("3_shop")
