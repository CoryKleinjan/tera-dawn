[ext_resource type="SpriteFrames" path="res://assets/animations/npc_driftcove_keeper.tres" id="2_sprite"]

[resource]
script = ExtResource("1_npc_def")
id = &"driftcove_keeper"
display_name = "Quartermaster Bess"
title = "Storage Keeper"
sprite_frames = ExtResource("2_sprite")
greeting = "Bess's hold, tight as a sealed barrel. Stow it here and any keeper in any town can hand it back."
