[ext_resource type="Script" path="res://scripts/data/npc_def.gd" id="1_npc_def"]
[ext_resource type="SpriteFrames" path="res://assets/animations/npc_storage_keeper.tres" id="2_sprite"]

[resource]
script = ExtResource("1_npc_def")
id = &"storage_keeper"
display_name = "Brin"
title = "Storage Keeper"
sprite_frames = ExtResource("2_sprite")
greeting = "Brin's vaults, at your service. Whatever you leave with me in one town, you'll find in every town."
lines = PackedStringArray("Ten Dawnshards a stack. Cheaper than losing it in a cave.", "I've never lost a single potion. Not one.")
storage = true
