[resource]
script = ExtResource("1_npc_def")
id = &"wagon_driver"
display_name = "Hobb"
title = "Wagon Driver"
sprite_frames = ExtResource("2_sprite")
greeting = "Need a lift? My wagon knows every road on the isle. Costs a few Dawnshards, saves a lot of walking."
lines = PackedStringArray("Ember Hollow's hot enough to cook an egg on the rocks. Bring potions.", "One day there'll be a proper ship to the mainland. Dawnharbor, they call the port there.", "If you're ever lost, a Return Scroll will bring you back to town. Mira sells them.")
travel = Array[ExtResource("3_travel_route")]([SubResource("Resource_1")])
