[gd_resource type="Resource" script_class="NpcDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_def.gd" id="1_npc_def"]
[ext_resource type="Texture2D" path="res://assets/sprites/npcs/village_elder.png" id="2_village_elder"]

[resource]
script = ExtResource("1_npc_def")
id = &"guide_sorrel"
display_name = "Guide Sorrel"
title = "Job Instructor"
texture = ExtResource("2_village_elder")
sprite_scale = 0.95
tint = Color(0.6, 0.78, 1.0, 1.0)
greeting = "Every hero in Tera Dawn walked this meadow once. When you're ready, I can set you on your path."
lines = PackedStringArray("Warriors, Archers, Magicians, Thieves and Pirates. Each sees the world differently.", "Magicians may begin their studies at level 8. Everyone else waits until 10.", "Put your Ability Points into the stat your path needs. A job asks for it before it takes you.", "Once you choose, there's no going back. Choose with your heart, not your purse.")
instructs = Array[StringName]([&"warrior", &"archer", &"mage", &"thief", &"pirate"])
