[resource]
script = ExtResource("1_npc_def")
id = &"guide_sorrel"
display_name = "Guide Sorrel"
title = "Job Guide"
texture = ExtResource("2_village_elder")
sprite_scale = 0.95
tint = Color(0.6, 0.780392, 1.0, 1.0)
greeting = "Every hero in Tera Dawn walked this meadow once. When you're ready to choose a path, the mainland's job towns will teach you."
lines = PackedStringArray("Warriors train in Emberforge, Archers in Greenbough, Magicians in Lumewood, Thieves in Lanternfall, Pirates in Driftcove.", "Magicians may begin their studies at level 8. Everyone else waits until 10.", "Put your Ability Points into the stat your path needs. A job asks for it before it takes you.", "Captain Marlo's ship takes you to Dawnharbor. From there, Rook's coach goes everywhere.")
storage = false
