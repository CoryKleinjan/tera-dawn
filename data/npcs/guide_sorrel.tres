[gd_resource type="Resource" script_class="NpcDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_def.gd" id="1_npc_def"]
[ext_resource type="SpriteFrames" path="res://assets/animations/npc_guide_sorrel.tres" id="2_sprite"]

[resource]
script = ExtResource("1_npc_def")
id = &"guide_sorrel"
display_name = "Guide Sorrel"
title = "Job Guide"
sprite_frames = ExtResource("2_sprite")
greeting = "Every hero in Morrowmere walked this meadow once. When you're ready to choose a path, the mainland's job towns will teach you."
lines = PackedStringArray("Warriors train in Emberforge, Archers in Greenbough, Magicians in Lumewood, Thieves in Lanternfall, Pirates in Driftcove.", "Every path opens at level 10, once you have the stat it asks for.", "Put your Ability Points into the stat your path needs. A job asks for it before it takes you.", "Captain Marlo's ship takes you to Dawnharbor. From there, Rook's coach goes everywhere.")
storage = false
