[ext_resource type="SpriteFrames" path="res://assets/animations/npc_lanternfall_instructor.tres" id="2_sprite"]

[resource]
script = ExtResource("1_npc_def")
id = &"lanternfall_instructor"
display_name = "Shade Vesper"
title = "Thief Instructor"
