[gd_resource type="Resource" script_class="NpcDef" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_def.gd" id="1_npc_def"]
[ext_resource type="SpriteFrames" path="res://assets/animations/npc_driftcove_instructor.tres" id="2_sprite"]

[resource]
script = ExtResource("1_npc_def")
id = &"driftcove_instructor"
display_name = "Captain Kestrel"
title = "Pirate Instructor"
sprite_frames = ExtResource("2_sprite")
greeting = "Ahoy. Fists or flintlock, it's all the same to the sea. Want to sail with my crew?"
lines = PackedStringArray("Advance at level 10, with the stat the path asks for.", "Practise on the fields outside town. That's what they're for.")
instructs = Array[StringName]([&"pirate", &"swashbuckler", &"sharpshooter"])
storage = false
