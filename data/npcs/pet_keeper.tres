[gd_resource type="Resource" script_class="NpcDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/npc_def.gd" id="1_npc_def"]
[ext_resource type="SpriteFrames" path="res://assets/animations/npc_pet_keeper.tres" id="2_sprite"]
[ext_resource type="Resource" path="res://data/shops/pet_shop.tres" id="3_pet_shop"]

[resource]
script = ExtResource("1_npc_def")
id = &"pet_keeper"
display_name = "Pet Keeper Pip"
title = "Pets & Chairs"
sprite_frames = ExtResource("2_sprite")
greeting = "Looking for a friend? My pets follow you anywhere and pick up what you leave behind. Chairs too, for a good long sit!"
lines = PackedStringArray("Pets get hungry. Keep some Pet Snacks on you, or they'll trot home.", "Sitting on a chair heals you faster. Move and you'll hop off.", "Bosses sometimes leave fancy chairs behind. Bring me a story about one!")
shop = ExtResource("3_pet_shop")
