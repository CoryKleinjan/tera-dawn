[gd_resource type="Resource" script_class="JobDef" format=3]

[ext_resource type="Script" path="res://scripts/data/job_def.gd" id="1_job_def"]

[resource]
script = ExtResource("1_job_def")
id = &"swashbuckler"
display_name = "Swashbuckler"
family = &"swashbuckler"
description = "Thieves and Pirates who flip, spin and shoot through a crowd, landing more critical hits the longer their streak runs. They learn every Thief and Pirate skill and wield both jobs' weapons."
advances_from = &"thief"
partner = &"pirate"
