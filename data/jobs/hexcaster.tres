[gd_resource type="Resource" script_class="JobDef" format=3]

[ext_resource type="Script" path="res://scripts/data/job_def.gd" id="1_job_def"]

[resource]
script = ExtResource("1_job_def")
id = &"hexcaster"
display_name = "Hexcaster"
family = &"hexcaster"
description = "Magicians and Thieves who curse monsters so every blow lands harder, then rain dark stars on them. They learn every Magician and Thief skill and wield both jobs' weapons."
advances_from = &"mage"
partner = &"thief"
