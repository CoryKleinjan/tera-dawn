[gd_resource type="Resource" script_class="JobDef" format=3]

[ext_resource type="Script" path="res://scripts/data/job_def.gd" id="1_job_def"]

[resource]
script = ExtResource("1_job_def")
id = &"sharpshooter"
display_name = "Sharpshooter"
family = &"sharpshooter"
description = "Pirates and Archers whose shots bounce from one monster to the next, and who can call a ship's cannons down on a crowd. They learn every Pirate and Archer skill and wield both jobs' weapons."
advances_from = &"pirate"
partner = &"archer"
