[gd_resource type="Resource" script_class="JobDef" format=3]

[ext_resource type="Script" path="res://scripts/data/job_def.gd" id="1_job_def"]

[resource]
script = ExtResource("1_job_def")
id = &"wildhunter"
display_name = "Wildhunter"
family = &"wildhunter"
description = "Archers and Warriors who mark their prey and charge in, with blade and bow at point-blank range. They learn every Archer and Warrior skill and wield both jobs' weapons."
advances_from = &"archer"
partner = &"warrior"
