[resource]
script = ExtResource("1_quest_def")
id = &"tear_greenbough_3"
title = "The Warden's Ring"
giver = &"greenbough_forager"
requires = Array[StringName]([&"tear_greenbough_2"])
offer_text = "Whatever that thing is, it's standing guard over the heart of it. While it stands, the grove keeps growing. I'm too old to swing anything heavier than a basket. It has to be you."
progress_text = "Mind the crack in its chest. If there's a light in there, that's where it's still alive."
complete_text = "It's done, then. (He listens to the trees for a long moment.) So why does it feel worse? Listen. The birds haven't come back. Not in there. Out here. (He presses something into your hand.) Take this. And keep your eyes open on the road. Something changed today, and I don't think it's changing back."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Warden")])
reward_shards = 5000
reward_items = Array[ExtResource("5_drop_entry")]([])
