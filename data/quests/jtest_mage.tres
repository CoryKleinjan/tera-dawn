count = 1

[resource]
script = ExtResource("1_quest_def")
id = &"jtest_mage"
title = "Job Test"
giver = &"lumewood_instructor"
offer_text = "So you wish to begin your studies. Every Magician walks the trial once. Cross the trial ground to its far end, and let the light guide you."
progress_text = "The trial ground is through the light by the wall."
complete_text = "You stood against something none of us has a name for. You are a Magician now. Come, my scholars must hear this from you."
hint = "Step into the light by the wall and press {move_up}"
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Boss")])
reward_items = Array[ExtResource("4_drop_entry")]([])
