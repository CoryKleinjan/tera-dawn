[resource]
script = ExtResource("1_quest_def")
id = &"q04_sweet_nectar"
title = "Sweet Nectar"
giver = &"shopkeeper"
requires = Array[StringName]([&"q02_moss_for_the_stall"])
repeatable = false
offer_text = "I'm baking honey cakes for the village, but I'm out of nectar. Petal Bats keep it in their wings. Could you collect five Petal Nectar?"
progress_text = "Five Petal Nectar. Only the Petal Bats have it, and they flutter up high."
complete_text = "Mmm, smell that! The first cake is yours. And a few Dawnshards for the trouble."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Resource_1")])
reward_essence = 1900
reward_shards = 200
reward_items = Array[ExtResource("5_drop_entry")]([SubResource("Resource_2")])
