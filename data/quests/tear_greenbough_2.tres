[resource]
script = ExtResource("1_quest_def")
id = &"tear_greenbough_2"
title = "Antlers Like Bone"
giver = &"greenbough_forager"
requires = Array[StringName]([&"tear_greenbough_1"])
offer_text = "Deer made of white stone, walking about as if they still had somewhere to be. If something in there is walking, something in there is waking. Go deeper and see where it leads. And thin out those stags before one of them finds its way out here."
progress_text = "Did the stags look at you? I keep wondering if they know what they've become."
complete_text = "A ring of stone trees at the very top, and something standing in the middle, taller than the rest. And it moved? (He sets his basket down.) Then that's where all this is coming from. It's spreading out from there, a little more each night."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Stags"), SubResource("Top")])
reward_shards = 1500
reward_items = Array[ExtResource("5_drop_entry")]([])
