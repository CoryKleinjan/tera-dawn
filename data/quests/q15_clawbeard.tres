[resource]
script = ExtResource("1_quest_def")
id = &"q15_clawbeard"
title = "Old Clawbeard"
giver = &"village_elder"
min_level = 9
requires = Array[StringName]([&"q01_dewling_trouble"])
offer_text = "Out on the Tidal Flats lives a crab older than this village. Old Clawbeard, the fishermen call him. He's been snapping nets again. Bring me his pearl and the shore is yours."
progress_text = "Old Clawbeard lives on the Tidal Flats, at the far west of the isle. Bring back Clawbeard's Pearl."
complete_text = "His pearl! The fishermen will sing about this. Take this, you've earned it."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Resource_1")])
reward_xp = 900
reward_shards = 1200
reward_items = Array[ExtResource("4_drop_entry")]([SubResource("Resource_2"), SubResource("Resource_3")])
