[resource]
script = ExtResource("1_quest_def")
id = &"q34_dawnharbor_boss"
title = "The Grotto Tusker"
giver = &"harbormaster"
requires = Array[StringName]([&"q33_dawnharbor_supplies"])
offer_text = "Smugglers' Grotto, past Gull Bluffs, has a new master: a great tusked boar the smugglers call the Grotto Tusker. No boat will put in there while it lives. Deal with it and the harbour owes you."
progress_text = "Defeat the Grotto Tusker in its den at the back of Smugglers' Grotto, past Gull Bluffs."
complete_text = "The boats are already heading out. The whole harbour will hear of this. Take these, and my thanks."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Resource_1")])
reward_shards = 6000
reward_items = Array[ExtResource("4_drop_entry")]([])
