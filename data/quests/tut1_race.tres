[resource]
script = ExtResource("3_filgh")
id = &"tut1_race"
title = "Race to the Big Rock"
giver = &"girl_on_beach"
offer_text = "You're all wet. Here, hold my hands. Huh, they feel warm today.

Do you have a name? It's okay if you forgot. Grandpa says the sea makes people forget things.

You can stay. But you have to play with me first. That's the rule. Race you to the big rock! Ready... go!"
progress_text = "Race you to the big rock! Ready... go!"
complete_text = "I win! You're slow. That's okay, you just woke up."
start_scene = ExtResource("4_ksdnq")
offer_hint = "Walk to her and press {move_up} to talk"
hint = "{move_left} {move_right} to move, {jump} to jump"
objectives = Array[ExtResource("1_50sa0")]([SubResource("Resource_ji6rw")])
