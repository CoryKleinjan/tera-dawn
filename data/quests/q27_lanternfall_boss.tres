[resource]
script = ExtResource("1_quest_def")
id = &"q27_lanternfall_boss"
title = "The Lantern Wraith"
giver = &"lanternfall_instructor"
requires = Array[StringName]([&"q26_lanternfall_supplies"])
offer_text = "At the end of our hunting grounds lives the Lantern Wraith. Only the strongest of us have faced it. Bring me the Wraith Lantern and I'll know you're ready."
progress_text = "Defeat the Lantern Wraith at the far end of the hunting grounds and bring back the Wraith Lantern."
complete_text = "You did it. The whole town will hear of this. Take this, and my respect."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Resource_1")])
reward_shards = 6000
reward_items = Array[ExtResource("4_drop_entry")]([])
