[resource]
script = ExtResource("1_quest_def")
id = &"q30_driftcove_boss"
title = "The Reef Titan"
giver = &"driftcove_instructor"
min_level = 22
requires = Array[StringName]([&"q29_driftcove_supplies"])
offer_text = "At the end of our hunting grounds lives the Reef Titan. Only the strongest of us have faced it. Bring me the Titan Coral and I'll know you're ready."
progress_text = "Defeat the Reef Titan at the far end of the hunting grounds and bring back the Titan Coral."
complete_text = "You did it. The whole town will hear of this. Take this, and my respect."
objectives = Array[ExtResource("2_quest_objective")]([SubResource("Resource_1")])
reward_xp = 188400
reward_shards = 6000
reward_items = Array[ExtResource("4_drop_entry")]([SubResource("Resource_2"), SubResource("Resource_3")])
